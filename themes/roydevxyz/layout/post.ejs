<article class="post">
  <%
    var currentLang = get_current_lang();
    var postTitle = i18n_field(page.title, currentLang);
  %>
  <header class="post-header">
    <h1 class="post-title"><%= postTitle %></h1>
    <div class="post-meta">
      <time datetime="<%= date_xml(page.date) %>">
        <%= date(page.date, 'YYYY-MM-DD HH:mm') %>
      </time>
      <% if (page.author) { %>
        <span class="post-author">by <%= page.author %></span>
      <% } %>
    </div>
  </header>

  <div class="post-content">
    <%- page.content %>
  </div>

  <% if (page.tags && page.tags.length) { %>
    <footer class="post-footer">
      <div class="post-tags">
        Tags:
        <% page.tags.each(function(tag) { %>
          <a href="<%- url_for(tag.path) %>" class="tag">#<%= tag.name %></a>
        <% }); %>
      </div>
    </footer>
  <% } %>

  <nav class="post-nav">
    <% if (page.prev) { %>
      <%
        var prevTitle = i18n_field(page.prev.title, currentLang);
      %>
      <a href="<%- url_for(page.prev.path) %>" class="post-nav-prev">
        ← <%= prevTitle %>
      </a>
    <% } %>
    <% if (page.next) { %>
      <%
        var nextTitle = i18n_field(page.next.title, currentLang);
      %>
      <a href="<%- url_for(page.next.path) %>" class="post-nav-next">
        <%= nextTitle %> →
      </a>
    <% } %>
  </nav>
</article>
