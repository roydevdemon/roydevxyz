<footer class="site-footer">
  <nav class="footer-statusbar">
    <div class="footer-container">
      <div class="footer-left">
        <span class="footer-status">●</span>
      </div>
      <div class="footer-right">
        <% if (theme.social) { %>
          <% for (var name in theme.social) { %>
            <a href="<%= theme.social[name] %>" target="_blank" rel="noopener" class="footer-link"><%= name %></a>
          <% } %>
        <% } %>
      </div>
    </div>
  </nav>
</footer>

<%- js('js/script') %>
