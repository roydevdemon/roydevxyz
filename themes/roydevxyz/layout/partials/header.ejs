<header class="site-header">
  <nav class="nav">
    <div class="nav-container">
      <div class="nav-left">
        <% for (var name in theme.menu) {
          var menuPath = theme.menu[name];
          var isActive = (menuPath === '/' && is_home()) || (menuPath !== '/' && path.indexOf(menuPath.replace(/^\//, '')) === 0);
        %>
          <a href="<%- url_for(menuPath) %>" class="nav-link<%= isActive ? ' active' : '' %>">
            <%= __('menu.' + name.toLowerCase()) || name %>
          </a>
        <% } %>
      </div>
      <div class="nav-right">
        <div class="language-switcher">
          <%
          var languages = config.language || ['en', 'ko'];
          if (typeof languages === 'string') {
            languages = [languages];
          }
          %>
          <%
          var langLabels = { en: 'English', ko: '한국어' };
          languages.forEach(function(lang) { %>
            <a href="#" class="lang-link" data-lang="<%= lang %>">
              <%= langLabels[lang] || lang.toUpperCase() %>
            </a>
          <% }); %>
        </div>
      </div>
    </div>
  </nav>
</header>
