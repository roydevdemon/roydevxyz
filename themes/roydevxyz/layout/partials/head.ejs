<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><% if (page.title) { %><%= page.title %> - <% } %><%= config.title %></title>

  <!-- Meta Tags -->
  <% if (page.description) { %>
    <meta name="description" content="<%= page.description %>">
  <% } else if (config.description) { %>
    <meta name="description" content="<%= config.description %>">
  <% } %>

  <% if (page.keywords) { %>
    <meta name="keywords" content="<%= page.keywords %>">
  <% } else if (config.keywords) { %>
    <meta name="keywords" content="<%= config.keywords %>">
  <% } %>

  <meta name="author" content="<%= config.author %>">

  <!-- Open Graph Tags -->
  <% if (is_post()) { %>
    <meta property="og:site_name" content="roydev.xyz">
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= page.title %>">
    <meta property="og:url" content="<%= config.url %>/<%= page.path %>">
    <meta property="og:image" content="<%= config.url %>/og/1200x630.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <%
      // Extract text content from lang-content div
      let ogDescription = '';
      if (page.content) {
        const langContentMatch = page.content.match(/<div class="lang-content">([\s\S]*?)<\/div>/);
        if (langContentMatch) {
          // Remove HTML tags and get plain text
          const plainText = langContentMatch[1]
            .replace(/<[^>]+>/g, '')
            .replace(/\s+/g, ' ')
            .trim();
          // Truncate to 100 characters and add ellipsis if needed
          ogDescription = plainText.length > 100
            ? plainText.substring(0, 100) + '...'
            : plainText;
        }
      }
    %>
    <% if (ogDescription) { %>
    <meta property="og:description" content="<%= ogDescription %>">
    <% } %>
  <% } %>

  <!-- Web Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/d2coding@1.3.2/d2coding-subset.min.css">

  <!-- Stylesheets -->
  <%- css('css/style') %>

  <!-- JavaScript -->
  <%- js('js/script') %>

  <!-- Favicon -->
  <% if (theme.favicon) { %>
    <link rel="icon" href="<%- url_for(theme.favicon) %>">
  <% } %>

  <!-- Google Analytics -->
  <% if (theme.google_analytics) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= theme.google_analytics %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= theme.google_analytics %>');
    </script>
  <% } %>
</head>
