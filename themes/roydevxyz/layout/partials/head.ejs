<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><% if (page.title && !is_home()) { %><%= page.title %> — <% } %><%= config.title %></title>

  <!-- SEO Meta -->
  <% if (page.description) { %>
    <meta name="description" content="<%= page.description %>">
  <% } else if (page.excerpt) { %>
    <meta name="description" content="<%- strip_html(page.excerpt).substring(0, 160) %>">
  <% } else if (config.description) { %>
    <meta name="description" content="<%= config.description %>">
  <% } %>

  <% if (page.keywords) { %>
    <meta name="keywords" content="<%= page.keywords %>">
  <% } else if (page.tags && page.tags.length) { %>
    <meta name="keywords" content="<%= page.tags.map(function(tag){ return tag.name; }).join(', ') %>">
  <% } else if (config.keywords) { %>
    <meta name="keywords" content="<%= config.keywords %>">
  <% } %>

  <meta name="author" content="<%= config.author %>">

  <!-- Canonical -->
  <link rel="canonical" href="<%= config.url %>/<%= page.path %>">

  <!-- Open Graph -->
  <meta property="og:site_name" content="roydev.xyz">
  <meta property="og:locale" content="en_US">
  <meta property="og:locale:alternate" content="ko_KR">

  <% if (is_post()) { %>
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= page.title %>">
    <meta property="og:url" content="<%= config.url %>/<%= page.path %>">
    <% if (page.cover) { %>
      <meta property="og:image" content="<%= config.url %><%- url_for(page.cover) %>">
    <% } else { %>
      <meta property="og:image" content="<%= config.url %>/og/1200x630.png">
    <% } %>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <% if (page.excerpt) { %>
      <meta property="og:description" content="<%- strip_html(page.excerpt).substring(0, 200) %>">
    <% } else if (page.content) { %>
      <meta property="og:description" content="<%- strip_html(page.content).substring(0, 200) %>">
    <% } %>
    <meta property="article:published_time" content="<%= date_xml(page.date) %>">
    <meta property="article:modified_time" content="<%= date_xml(page.updated) %>">
    <meta property="article:author" content="<%= config.author %>">
    <% if (page.tags && page.tags.length) { %>
      <% page.tags.each(function(tag) { %>
        <meta property="article:tag" content="<%= tag.name %>">
      <% }); %>
    <% } %>
  <% } else { %>
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= config.title %>">
    <meta property="og:url" content="<%= config.url %>/<%= page.path %>">
    <meta property="og:image" content="<%= config.url %>/og/1200x630.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:description" content="<%= config.description %>">
  <% } %>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@roydevdemon">
  <meta name="twitter:creator" content="@roydevdemon">

  <!-- Web Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Stylesheets -->
  <%- css('css/style') %>

  <!-- Favicon -->
  <% if (theme.favicon) { %>
    <link rel="icon" href="<%- url_for(theme.favicon) %>">
  <% } %>

  <!-- Google Analytics -->
  <% if (theme.google_analytics) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= theme.google_analytics %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= theme.google_analytics %>');
    </script>
  <% } %>
</head>
