<article class="page about-page">
  <%
    var languages = config.language || ['en'];
    if (typeof languages === 'string') {
      languages = [languages];
    }
  %>

  <% languages.forEach(function(lang, index) { %>
    <div class="lang-content" data-lang="<%= lang %>" <% if (index !== 0) { %>style="display:none;"<% } %>>
      <header class="about-header">
        <h1 class="about-title">
          <%= typeof page.title === 'object' ? (page.title[lang] || page.title.en || page.title) : page.title %>
        </h1>
        <% if (page.subtitle) { %>
          <p class="about-subtitle">
            <%= typeof page.subtitle === 'object' ? (page.subtitle[lang] || page.subtitle.en || page.subtitle) : page.subtitle %>
          </p>
        <% } %>
      </header>

      <div class="about-content">
        <% if (typeof page.content_i18n === 'object' && page.content_i18n[lang]) { %>
          <%- render_markdown(page.content_i18n[lang]) %>
        <% } else { %>
          <%- page.content %>
        <% } %>
      </div>

      <% if (page.skills && page.skills.length) { %>
        <section class="about-section">
          <h2 class="section-title">
            <%= lang === 'ko' ? '기술' : 'Skills' %>
          </h2>
          <div class="skills-grid">
            <% page.skills.forEach(function(skill) { %>
              <div class="skill-item">
                <% if (skill.icon) { %>
                  <span class="skill-icon"><%= skill.icon %></span>
                <% } %>
                <span class="skill-name">
                  <%= typeof skill.name === 'object' ? (skill.name[lang] || skill.name.en || skill.name) : skill.name %>
                </span>
              </div>
            <% }); %>
          </div>
        </section>
      <% } %>

      <% if (page.experience && page.experience.length) { %>
        <section class="about-section">
          <h2 class="section-title">
            <%= lang === 'ko' ? '경력' : 'Experience' %>
          </h2>
          <div class="experience-list">
            <% page.experience.forEach(function(exp) { %>
              <div class="experience-item">
                <div class="experience-header">
                  <h3 class="experience-title">
                    <%= typeof exp.title === 'object' ? (exp.title[lang] || exp.title.en || exp.title) : exp.title %>
                  </h3>
                  <span class="experience-period"><%= exp.period %></span>
                </div>
                <p class="experience-company">
                  <%= typeof exp.company === 'object' ? (exp.company[lang] || exp.company.en || exp.company) : exp.company %>
                </p>
                <% if (exp.description) { %>
                  <p class="experience-description">
                    <%= typeof exp.description === 'object' ? (exp.description[lang] || exp.description.en || exp.description) : exp.description %>
                  </p>
                <% } %>
              </div>
            <% }); %>
          </div>
        </section>
      <% } %>

      <% if (page.contact && Object.keys(page.contact).length) { %>
        <section class="about-section">
          <h2 class="section-title">
            <%= lang === 'ko' ? '연락처' : 'Contact' %>
          </h2>
          <div class="contact-links">
            <% for (var key in page.contact) { %>
              <a href="<%= page.contact[key] %>" class="contact-link" target="_blank" rel="noopener">
                <%= key %>
              </a>
            <% } %>
          </div>
        </section>
      <% } %>
    </div>
  <% }); %>
</article>

