<article class="page about-page">
  <%
    var languages = config.language || ['en'];
    if (typeof languages === 'string') {
      languages = [languages];
    }
  %>

  <% languages.forEach(function(lang, index) { %>
    <div class="lang-content" data-lang="<%= lang %>" <% if (index !== 0) { %>style="display:none;"<% } %>>
      <div class="about-content">
        <% if (typeof page.content_i18n === 'object' && page.content_i18n[lang]) { %>
          <%- render_markdown(page.content_i18n[lang]) %>
        <% } else { %>
          <%- page.content %>
        <% } %>
      </div>

      <% if (page.skills && page.skills.length) { %>
        <section class="about-section">
          <h2 class="section-title">
           Skills
          </h2>
          <div class="skills-list">
            <% page.skills.forEach(function(skill) { %>
              <div class="skill-category">
                <div class="skill-category-header">
                  <% if (skill.icon) { %>
                    <span class="skill-icon"><%= skill.icon %></span>
                  <% } %>
                  <h3 class="skill-category-name">
                    <%= typeof skill.category === 'object' ? (skill.category[lang] || skill.category.en || skill.category) : skill.category %>
                  </h3>
                </div>
                <% if (skill.items && skill.items.length) { %>
                  <ul class="skill-items">
                    <% skill.items.forEach(function(item) { %>
                      <li class="skill-item"><%= item %></li>
                    <% }); %>
                  </ul>
                <% } %>
              </div>
            <% }); %>
          </div>
        </section>
      <% } %>

      <% if (page.projects && page.projects.length) { %>
        <section class="about-section">
          <h2 class="section-title">
            <%= lang === 'ko' ? '프로젝트' : 'Projects' %>
          </h2>
          <div class="projects-list">
            <% page.projects.forEach(function(project) { %>
              <div class="project-item">
                <div class="project-header">
                  <h3 class="project-name">
                    <%= typeof project.name === 'object' ? (project.name[lang] || project.name.en || project.name) : project.name %>
                  </h3>
                  <% if (project.date) { %>
                    <span class="project-date"><%= project.date %></span>
                  <% } %>
                </div>
                <% if (project.type) { %>
                  <p class="project-type">
                    <%= typeof project.type === 'object' ? (project.type[lang] || project.type.en || project.type) : project.type %>
                  </p>
                <% } %>
                <% if (project.description) { %>
                  <p class="project-description">
                    <%= typeof project.description === 'object' ? (project.description[lang] || project.description.en || project.description) : project.description %>
                  </p>
                <% } %>
                <% if (project.github || project.website) { %>
                  <div class="project-links">
                    <% if (project.github) { %>
                      <a href="<%= project.github %>" class="project-link" target="_blank" rel="noopener">
                        GitHub
                      </a>
                    <% } %>
                    <% if (project.website) { %>
                      <a href="<%= project.website %>" class="project-link" target="_blank" rel="noopener">
                        Website
                      </a>
                    <% } %>
                  </div>
                <% } %>
              </div>
            <% }); %>
          </div>
        </section>
      <% } %>

      <% if (page.contact && Object.keys(page.contact).length) { %>
        <section class="about-section">
          <h2 class="section-title">
            Contacts
          </h2>
          <div class="contact-links">
            <%
              var iconMap = {
                'email': 'fa-envelope',
                'github': 'fa-github',
                'twitter': 'fa-twitter',
                'linkedin': 'fa-linkedin',
                'instagram': 'fa-instagram',
                'facebook': 'fa-facebook',
                'youtube': 'fa-youtube',
                'discord': 'fa-discord',
                'telegram': 'fa-telegram',
                'whatsapp': 'fa-whatsapp',
                'phone': 'fa-phone',
                'website': 'fa-globe'
              };
            %>
            <% for (var key in page.contact) { %>
              <a href="<%= page.contact[key] %>" class="contact-link" target="_blank" rel="noopener" title="<%= key %>">
                <i class="fa-brands <%= iconMap[key.toLowerCase()] || 'fa-link' %>"></i>
              </a>
            <% } %>
          </div>
        </section>
      <% } %>
    </div>
  <% }); %>
</article>

