<div class="terminal-home">
  <!-- Terminal Welcome Screen -->
  <div class="terminal-session">
    <div class="terminal-line">
      <span class="prompt">$</span>
      <span class="command"><%= __('home.whoami') %></span>
    </div>
    <div class="terminal-output profile-box">
      <div class="profile-header">
        <img src="<%- url_for('/persona.png') %>" alt="<%= __('home.profile_header') %>" class="profile-header-image">
      </div>
      <div class="profile-description lang-content" data-lang="en">
         <h2>Focusing on substance over style.</h2>
        I work as a Backend Developer at a startup, but my role extends beyond simple feature implementation.<br/>
        I proactively engage with the business as a whole—including marketing and planning—to propose valuable ideas.<br/>
        I solve problems based on data, not intuition, and continuously strive for customer satisfaction and team success rather than personal achievement.
      </div>
      <div class="profile-description lang-content" data-lang="ko">
        <h2>화려한 겉모습보다 본질에 집중합니다.</h2>
        스타트업에서 백엔드 개발자로 일하고 있지만 단순히 기능 구현에 그치지 않고 마케팅 및 기획 등 비즈니스 전반에 관심을 가지며 아이디어를 제안합니다. <br/>
        직감보다는 데이터에 기반해 주어진 문제를 해결하며 개인의 성취보다 고객의 만족을 위해 끊임없이 고민하고 시도합니다. 
      </div>
    </div>

    <div class="terminal-line">
      <span class="prompt">$</span>
      <span class="command"><a href="<%- url_for('/about') %>" style="color: var(--terminal-green); text-decoration: none;">cat ~/About</a></span>
    </div>

    <%
    // Get all posts sorted by date (newest first) and limit to 5
    var recentPosts = site.posts.sort('-date').limit(5);
    %>
    <% if (recentPosts && recentPosts.length) { %>
      <div class="terminal-line">
        <span class="prompt">$</span>
        <span class="command">ls -lht ~/Essays | head -6 </span>
      </div>
      <div class="terminal-output">
        <div class="contents-grid">
          <% recentPosts.each(function(post) { %>
            <a href="<%- url_for(post.path) %>" class="contents-card">
              <div class="contents-card__header">
                <span class="contents-card__name"><%= post.title %></span>
                <span class="contents-card__count"><%= date(post.date, 'YYYY-MM-DD') %></span>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <% if (page.total > 1) { %>
    <nav class="terminal-pagination">
      <%- paginator({
        prev_text: '← prev',
        next_text: 'next →'
      }) %>
    </nav>
  <% } %>
</div>
