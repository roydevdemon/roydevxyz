<div class="hero">
  <div class="hero-profile">
    <img src="<%- url_for('/persona.png') %>" alt="<%= __('home.profile_header') %>" class="hero-image">
  </div>
  <div class="hero-description lang-content" data-lang="en">
    <h1>Make fantasy a reality</h1>
    <p>
      I'm a Product-minded Builder dedicated to transforming imagination into reality.<br/>
      Unafraid of new challenges, I focus on solving problems with a strictly objective perspective, setting aside prejudice regarding age, gender, or background.<br/>
      I always approach the core essence through the 'Why,' not the 'What,' and honestly express my own thoughts.
    </p>
  </div>
  <div class="hero-description lang-content" data-lang="ko">
    <h1>Make fantasy a reality</h1>
    <p>
      상상을 현실로 만드는 것에 몰두하는 프로덕트 빌더입니다.<br/>
      새로운 도전을 두려워하지 않으며, 나이, 성별, 성향 등 그 어떤 편견을 배제하고 오직 객관적인 시선으로 문제를 해결하는 데 집중합니다.<br/>
      항상 '무엇(What)'이 아닌 '왜(Why)'를 통해 본질에 접근하며 저만의 생각을 솔직하게 표현합니다.
    </p>
  </div>

  <% var recentPosts = site.posts.sort('-date').limit(5); %>
  <% if (recentPosts && recentPosts.length) { %>
    <section class="hero-recent">
      <ul class="hero-recent-list">
        <% recentPosts.each(function(post) { %>
          <li class="hero-recent-item">
            <a href="<%- url_for(post.path) %>">
              <span class="hero-recent-title"><%= post.title %></span>
              <span class="hero-recent-date"><%= date(post.date, 'YYYY.MM.DD') %></span>
            </a>
          </li>
        <% }); %>
      </ul>
      <a href="<%- url_for('/article') %>" class="hero-recent-more">More &rarr;</a>
    </section>
  <% } %>
</div>
