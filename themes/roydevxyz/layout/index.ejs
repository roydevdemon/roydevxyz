<div class="terminal-home">
  <!-- Terminal Welcome Screen -->
  <div class="terminal-session">
    <div class="terminal-line">
      <span class="prompt">$</span>
      <span class="command"><%= __('home.whoami') %></span>
    </div>
    <div class="terminal-output profile-box">
      <div class="profile-header">
        <img src="<%- url_for('/persona.png') %>" alt="<%= __('home.profile_header') %>" class="profile-header-image">
      </div>
      <div class="profile-description lang-content" data-lang="en">
        Hello there? 
      </div>
      <div class="profile-description lang-content" data-lang="ko">
        안녕?
      </div>
    </div>

    <div class="terminal-line">
      <span class="prompt">$</span>
      <span class="command"><a href="<%- url_for('/about') %>" style="color: var(--terminal-green); text-decoration: none;"><%= __('home.about_link') %></a></span>
    </div>

    <% var categories = site && site.categories ? site.categories.sort('name') : null; %>
    <% if (categories && categories.length) { %>
      <div class="terminal-line">
        <span class="prompt">$</span>
        <span class="command"><%= __('home.ls_categories') %></span>
      </div>
      <div class="terminal-output">
        <div class="contents-grid">
          <% categories.each(function(category) { %>
            <% if (!category.length) { return; } %>
            <a href="<%- url_for(category.path) %>" class="contents-card">
              <div class="contents-card__header">
                <span class="contents-card__name"><%= category.name %></span>
                <span class="contents-card__count"><%= category.length %> <%= __('home.posts_count') %></span>
              </div>
              <div class="contents-card__path">/<%= category.path %></div>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>

    <div class="terminal-line terminal-input-line">
      <span class="prompt">$</span>
      <input type="text" class="terminal-input" id="terminalInput" placeholder="" autocomplete="off" />
    </div>
  </div>

  <% if (page.total > 1) { %>
    <nav class="terminal-pagination">
      <%- paginator({
        prev_text: '← prev',
        next_text: 'next →'
      }) %>
    </nav>
  <% } %>
</div>
