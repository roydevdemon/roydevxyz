<div class="terminal-home">
  <div class="terminal-session">
    <div class="terminal-line">
      <span class="prompt">$</span>
      <span class="command">Essays</span>
    </div>

    <% var allPosts = site.posts.sort('-date'); %>
    <% if (allPosts && allPosts.length) { %>
      <div class="terminal-output">
        <div class="contents-grid">
          <% allPosts.each(function(post) { %>
            <a href="<%- url_for(post.path) %>" class="contents-card">
              <div class="contents-card__header">
                <span class="contents-card__name"><%= post.title %></span>
                <span class="contents-card__count"><%= date(post.date, 'YYYY-MM-DD') %></span>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    <% } else { %>
      <div class="terminal-output">
        <p>No essays yet.</p>
      </div>
    <% } %>
  </div>
</div>

